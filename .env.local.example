# Rani Channamma Hitech Nursery Environment Configuration Example
# Copy this file to .env.local for local development or set these variables in Vercel.

# Admin Authentication
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here

# Cloudinary Integration (Direct image uploads for plant varieties & greenhouse gallery)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Server Session Secret
JWT_SECRET=your_jwt_secret_key_here
